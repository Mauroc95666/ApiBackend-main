# =====================================================================
#  Variables de entorno - Panadería Kiataque
#  1) Copiá este archivo a un archivo llamado  .env
#  2) Cambiá la contraseña por una tuya
#  El archivo .env REAL no se sube a GitHub (está en .gitignore).
# =====================================================================

# Contraseña del usuario 'sa' de SQL Server.
# Requisitos: mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo.
SA_PASSWORD=Kiataque2026!

# Contraseña del super-usuario (superadmin@kiataque.bo). Si se deja vacía, el
# sistema genera una al azar y la escribe en el log la primera vez.
SUPERADMIN_PASSWORD=Kiataque2026!

# Clave con la que se firman los tokens de sesión. Poné cualquier texto largo
# y difícil de adivinar. Si se deja vacía, se genera una nueva en cada arranque
# y las sesiones abiertas se cierran al reiniciar.
TOKEN_SECRET=cambia-esto-por-un-texto-largo-y-secreto-2026

# Meta de minutos para entregar un pedido (se usa en los reportes de tiempos).
META_MINUTOS_PEDIDO=30

# Respaldo automatico de la base: cada cuantas horas corre (0 lo desactiva)
# y cuantos respaldos automaticos se conservan.
RESPALDO_CADA_HORAS=24
RESPALDOS_A_CONSERVAR=10
